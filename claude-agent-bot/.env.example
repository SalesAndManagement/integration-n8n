# ---- Обов'язкове ----------------------------------------------------------
# Ключ з https://platform.claude.com -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Токен бота з @BotFather
TELEGRAM_BOT_TOKEN=123456:AA...
# Хто має право писати боту (свій id дізнатись у @userinfobot). Через кому.
# Порожній список = бот не стартує.
TELEGRAM_ALLOWED_USER_IDS=123456789

# ---- Режим роботи ---------------------------------------------------------
# sandbox    — усі інструменти Claude Code без підтверджень. Межа — контейнер:
#              агент вільно робить усе всередині /data і нічого не бачить зовні.
# restricted — тільки інструменти з ALLOWED_TOOLS, решта отримує відмову.
AGENT_MODE=sandbox
ALLOWED_TOOLS=Read,Glob,Grep,WebSearch,WebFetch,mcp__n8n__trigger_workflow

# ---- Модель і бюджет ------------------------------------------------------
# claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5
# Глибина міркувань: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# Стоп по оцінці вартості одного запиту, USD
MAX_BUDGET_USD=0.50
# Максимум кроків агента на один запит
MAX_TURNS=20

# ---- Папка агента ---------------------------------------------------------
# Усередині контейнера фіксовано /data (див. docker-compose.yml).
# На хості це ./data поруч із docker-compose.yml.
AGENT_WORKSPACE=/data/workspace
SYSTEM_PROMPT=Ти — робочий асистент у Telegram із доступом до shell, файлів і браузера всередині власного контейнера. Відповідай стисло й українською. Перед незворотними діями коротко скажи, що робиш.
# Показувати у відповіді, які інструменти агент викликав і скільки це коштувало
SHOW_TOOL_TRACE=1

# ---- Браузер (Playwright MCP) ---------------------------------------------
BROWSER_ENABLED=1
BROWSER_HEADLESS=1
# Пісочниця chromium не працює під non-root у контейнері — лишай 1
BROWSER_NO_SANDBOX=1
# 1 = логіни й куки живуть між рестартами (профіль у /data/browser-profile)
BROWSER_PERSIST_PROFILE=1
BROWSER_VIEWPORT=1280x720
# Додаткові можливості: vision (скріншоти за координатами), pdf, devtools
BROWSER_CAPS=vision,pdf
# У Docker-образі пакет уже встановлено глобально; локально лишай npx.
# Для встановлення без root ці два рядки проставляє scripts/setup-native.sh:
#   BROWSER_MCP_CLI  — шлях до cli.js у vendor/
#   BROWSER_NODE     — який саме node запускати (може бути vendor/node/bin/node)
BROWSER_MCP_COMMAND=npx
BROWSER_MCP_PACKAGE=@playwright/mcp@0.0.81

# ---- n8n ------------------------------------------------------------------
# У docker-compose сусідній сервіс: http://n8n:5678
N8N_WEBHOOK_BASE_URL=http://n8n:5678
# Необов'язково: значення заголовка для Header Auth на боці n8n
N8N_WEBHOOK_TOKEN=
