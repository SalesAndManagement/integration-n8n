# ---- Обов'язкове ----------------------------------------------------------
# Ключ з https://platform.claude.com -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Токен бота з @BotFather
TELEGRAM_BOT_TOKEN=123456:AA...
# Хто має право писати боту (свій id дізнатись у @userinfobot). Через кому.
# Порожній список = бот не стартує: у агента є доступ до файлів і мережі.
TELEGRAM_ALLOWED_USER_IDS=123456789

# ---- Модель і бюджет ------------------------------------------------------
# claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5
# Глибина міркувань: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# Жорсткий стоп по вартості одного запиту (оцінка на боці клієнта), USD
MAX_BUDGET_USD=0.50
# Максимум кроків агента (виклик інструмента -> результат) на один запит
MAX_TURNS=20

# ---- Пісочниця агента -----------------------------------------------------
# Каталог, який агент бачить як робочий. Тримай тут тільки те, що йому можна.
AGENT_WORKSPACE=/data/workspace
# Інструменти, дозволені без запиту. Усе інше агент отримає як "denied".
# Додай Edit,Write,Bash тільки якщо свідомо цього хочеш.
ALLOWED_TOOLS=Read,Glob,Grep,WebSearch,WebFetch,mcp__n8n__trigger_workflow
SYSTEM_PROMPT=Ти — робочий асистент у Telegram. Відповідай стисло й українською. Перед запуском n8n workflow коротко скажи, що саме запускаєш.
# Показувати у відповіді, які інструменти агент викликав
SHOW_TOOL_TRACE=1

# ---- n8n ------------------------------------------------------------------
# База для webhook-ів. У docker-compose сусідній сервіс: http://n8n:5678
N8N_WEBHOOK_BASE_URL=http://n8n:5678
# Необов'язково: значення заголовка для Header Auth на боці n8n
N8N_WEBHOOK_TOKEN=
