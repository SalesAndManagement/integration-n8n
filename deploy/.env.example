# ============================================================
#  n8n + PostgreSQL — конфігурація
#  Скопіюйте у .env  і заповніть:  cp .env.example .env
#  Файл .env містить секрети — у git не комітиться.
# ============================================================

# --- Домен і TLS -------------------------------------------
# A-запис цього домену має вказувати на IP вашого Contabo VPS
N8N_DOMAIN=n8n.example.com
# Пошта для Let's Encrypt (сповіщення про сертифікати)
LETSENCRYPT_EMAIL=admin@example.com

# --- Часовий пояс ------------------------------------------
TIMEZONE=Europe/Warsaw

# --- PostgreSQL --------------------------------------------
POSTGRES_DB=n8n
# Адмінський користувач БД (використовується лише для міграцій/бекапів)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ЗМІНІТЬ_МЕНЕ_openssl_rand_base64_24
# Окремий користувач, від якого працює n8n
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=ЗМІНІТЬ_МЕНЕ_openssl_rand_base64_24
# Розмір пулу з'єднань (2 vCPU ≈ 4, 4 vCPU ≈ 8)
DB_POSTGRESDB_POOL_SIZE=4

# --- Ключ шифрування credentials ---------------------------
# Згенеруйте:  openssl rand -hex 32
# ⚠️ Після першого запуску НЕ міняти: усі збережені credentials стануть нечитабельними.
N8N_ENCRYPTION_KEY=ЗМІНІТЬ_МЕНЕ_openssl_rand_hex_32

# --- Версія n8n --------------------------------------------
# latest — завжди свіжа; для продакшену краще зафіксувати, напр. 1.115.2
N8N_IMAGE_TAG=latest

# --- Історія виконань --------------------------------------
# all | none  — чи зберігати успішні виконання
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
# Скільки годин тримати історію (336 = 14 днів)
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000

# --- Логи / телеметрія -------------------------------------
N8N_LOG_LEVEL=info
N8N_DIAGNOSTICS_ENABLED=false

# --- Режим черги (опційно) ---------------------------------
# regular — один процес (за замовчуванням, достатньо для більшості).
# queue   — + redis + воркери; запускати з профілем:
#           docker compose --profile queue up -d
EXECUTIONS_MODE=regular
N8N_WORKER_CONCURRENCY=5
