# ==== домен / TLS ====
DOMAIN=n8n.example.com
ACME_EMAIL=you@example.com

# ==== версія n8n (краще пінити конкретну, напр. 1.90.2) ====
N8N_VERSION=latest

# ==== секрети (генеруються install.sh) ====
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME

# ==== масштаб ====
WORKER_REPLICAS=2
WORKER_CONCURRENCY=10
WEBHOOK_REPLICAS=1
DB_POOL_SIZE=20
QUEUE_WORKER_TIMEOUT=300

# ==== ресурси БД/кешу (під RAM сервера) ====
PG_MAX_CONNECTIONS=300
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE=6GB
PG_WORK_MEM=16MB
REDIS_MAXMEMORY=2gb

# ==== великі ліміти n8n ====
NODE_OPTIONS=--max-old-space-size=4096
N8N_PAYLOAD_SIZE_MAX=256
N8N_FORMDATA_FILE_SIZE_MAX=1024
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_BINARY_DATA_STORAGE_PATH=/home/node/.n8n/binaryData
EXECUTIONS_TIMEOUT=-1
EXECUTIONS_TIMEOUT_MAX=7200
N8N_GRACEFUL_SHUTDOWN_TIMEOUT=300

# ==== чистка історії виконань (щоб БД не роздувалась) ====
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000

# ==== мережа / проксі ====
N8N_HOST=n8n.example.com
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n.example.com
WEBHOOK_URL=https://n8n.example.com/
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true
N8N_LISTEN_ADDRESS=0.0.0.0

# ==== виконання ====
N8N_RUNNERS_ENABLED=true
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
N8N_METRICS=true
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=*
NODE_FUNCTION_ALLOW_EXTERNAL=*

# ==== бекапи ====
BACKUP_KEEP_DAYS=14
TZ=Europe/Kyiv
