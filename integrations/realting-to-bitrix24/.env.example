# ---------- сервер ----------
N8N_HOST=n8n.example.com          # A-запис домену має вказувати на IP сервера
TZ=Europe/Kyiv
N8N_VERSION=latest                 # у проді краще зафіксувати, напр. 1.109.2

# ---------- n8n ----------
# openssl rand -hex 32   -> НЕ міняти після першого запуску (ним шифруються креденшели)
N8N_ENCRYPTION_KEY=
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

# ---------- Realting ----------
# URL з кабінету: https://realting.com/ru/account/orders/api-export
REALTING_EXPORT_URL=https://realting.com/api/orders/export
REALTING_API_TOKEN=
# bearer | header | query  — як саме платформа приймає токен
REALTING_AUTH_MODE=bearer

# ---------- Bitrix24 ----------
# Вхідний вебхук: Розробникам -> Інші -> Вхідний вебхук (права crm)
# Формат: https://<портал>.bitrix24.ua/rest/<user_id>/<token>/
BITRIX_WEBHOOK_URL=
BITRIX_ASSIGNED_BY_ID=1

# ---------- алерти (необовʼязково) ----------
ALERT_TELEGRAM_CHAT_ID=
