# /etc/realting-sync.env — права 640, власник root:realting

# ---------- Realting ----------
# URL зі сторінки https://realting.com/ru/account/orders/api-export
REALTING_EXPORT_URL=https://realting.com/api/orders/export
REALTING_API_TOKEN=
# як платформа приймає токен: bearer | header | query | basic | none
REALTING_AUTH_MODE=bearer
# для REALTING_AUTH_MODE=header / query
#REALTING_AUTH_HEADER=X-Api-Key
#REALTING_AUTH_QUERY_PARAM=token

# Назви параметрів запиту — підлаштувати під реальну специфікацію
REALTING_PARAM_DATE_FROM=date_from
REALTING_PARAM_DATE_TO=date_to
REALTING_PARAM_PAGE=page
REALTING_PARAM_LIMIT=limit
REALTING_PAGE_SIZE=200
REALTING_PAGINATION=page
REALTING_DATE_FORMAT=%Y-%m-%d %H:%M:%S
# додаткові сталі параметри через кому: REALTING_EXTRA_PARAMS=format=json,status=new
#REALTING_EXTRA_PARAMS=
# файл із власним мапінгом полів, коли типових назв не вистачило
#REALTING_FIELD_MAP_FILE=/etc/realting-sync.map.json

# ---------- Bitrix24 ----------
# Вхідний вебхук із правами CRM: https://<портал>.bitrix24.ua/rest/<user_id>/<token>/
BITRIX_WEBHOOK_URL=
BITRIX_EXTERNAL_ID_FIELD=UF_CRM_REALTING_ID
BITRIX_ASSIGNED_BY_ID=1
BITRIX_SOURCE_ID=WEB
# Y — повторне звернення додає коментар до наявного ліда замість нового
BITRIX_COMMENT_ON_DUPLICATE=true

# ---------- синхронізація ----------
STATE_PATH=/var/lib/realting-sync/state.db
SYNC_OVERLAP_MINUTES=15
SYNC_FIRST_RUN_DAYS=7
LOG_LEVEL=INFO
