[Unit]
Description=Імпорт заявок realting.com у Bitrix24
Documentation=https://github.com/SalesAndManagement/integration-n8n
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=realting
Group=realting
WorkingDirectory=/opt/realting-sync
Environment=PYTHONPATH=/opt/realting-sync/src
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/realting-sync.env
ExecStart=/usr/bin/python3 -m realting_sync sync
TimeoutStartSec=600

# Ізоляція: сервісу потрібні лише власний каталог стану й мережа
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/realting-sync
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
