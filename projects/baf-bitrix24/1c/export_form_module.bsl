////////////////////////////////////////////////////////////////////////////////
// Модуль формы внешней обработки "BAF: проба выгрузки товаров и остатков"
//
// ЧТО ДЕЛАЕТ: находит в конфигурации регистр остатков, читает из него первые
// 100 строк вместе с данными номенклатуры и пишет один JSON-файл.
//
// БЕЗОПАСНОСТЬ. Обработка:
//   - выполняет ТОЛЬКО запрос на чтение (ВЫБРАТЬ), без записи;
//   - ничего не создаёт, не изменяет и не удаляет в базе;
//   - не изменяет конфигурацию;
//   - не устанавливает монопольный режим;
//   - ограничена 100 строками, то есть не нагружает файловую базу;
//   - НИЧЕГО НЕ ОТПРАВЛЯЕТ в сеть: только локальный файл.
//
// Если структура конфигурации окажется не такой, как ожидается, обработка всё
// равно запишет файл - с описанием метаданных и текстом ошибки, чтобы было
// видно, какие имена использовать.
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Выгрузка запускается сразу при открытии - кнопку создавать не нужно.
	Путь = ВыполнитьНаСервере(100);

	// Пакетный запуск: 1cv8.exe ... /Execute <файл.epf> /C"AUTO" - закрываемся сами.
	Если ВРег(СокрЛП(ПараметрЗапуска)) = "AUTO" Тогда
		ЗавершитьРаботуСистемы(Ложь, Ложь);
	Иначе
		Сообщить("Готово. Файл: " + Путь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Выполнить(Команда)

	Путь = ВыполнитьНаСервере(100);
	Сообщить("Готово. Файл: " + Путь);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыполнитьНаСервере(ЛимитСтрок)

	СистемнаяИнформацияСеанса = Новый СистемнаяИнформация;

	Отчет = Новый Структура;
	Отчет.Вставить("ДатаВыгрузки",        Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Отчет.Вставить("ВерсияПлатформы",     СистемнаяИнформацияСеанса.ВерсияПриложения);
	Отчет.Вставить("ИмяКонфигурации",     Метаданные.Имя);
	Отчет.Вставить("СинонимКонфигурации", Метаданные.Синоним);
	Отчет.Вставить("ВерсияКонфигурации",  Метаданные.Версия);
	Отчет.Вставить("ЛимитСтрок",          ЛимитСтрок);

	// 1. Все регистры остатков - чтобы было видно, из чего выбирали.
	Отчет.Вставить("РегистрыОстатков", ОписаниеРегистровОстатков());

	// 2. Выбранный регистр и пробная выборка данных.
	ВыбранныйРегистр = ВыбратьРегистрЗапасов();

	Если ВыбранныйРегистр = Неопределено Тогда
		Отчет.Вставить("Ошибка", "Не найден регистр накопления остатков с измерением по номенклатуре."
			+ " Список кандидатов - в разделе РегистрыОстатков.");
		Отчет.Вставить("Строки", Новый Массив);
	Иначе
		Отчет.Вставить("ИспользованРегистр", ВыбранныйРегистр.ИмяРегистра);
		Отчет.Вставить("ПоляРегистра",       ВыбранныйРегистр);

		Попытка
			Отчет.Вставить("Строки", ПробнаяВыборка(ВыбранныйРегистр, ЛимитСтрок));
		Исключение
			// Файл всё равно должен получиться - с текстом ошибки и метаданными.
			Отчет.Вставить("Ошибка", ОписаниеОшибки());
			Отчет.Вставить("Строки", Новый Массив);
			Отчет.Вставить("ТекстЗапроса", ВыбранныйРегистр.ТекстЗапроса);
		КонецПопытки;
	КонецЕсли;

	// 3. Справочно: структура справочника номенклатуры.
	Если ВыбранныйРегистр <> Неопределено Тогда
		Отчет.Вставить("ПоляНоменклатуры", ПоляСправочника(ВыбранныйРегистр.ИмяСправочникаНоменклатуры));
	КонецЕсли;

	ПутьФайла = КаталогВременныхФайлов() + "baf_export_proba.json";
	ЗаписатьJSONВФайл(Отчет, ПутьФайла);

	Возврат ПутьФайла;

КонецФункции

// --- поиск регистра и его полей -------------------------------------------------

&НаСервереБезКонтекста
Функция ИмяПоМаске(Коллекция, Маска)

	Для Каждого Поле Из Коллекция Цикл
		Если СтрНайти(НРег(Поле.Имя), НРег(Маска)) > 0 Тогда
			Возврат Поле.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеРегистровОстатков()

	Результат = Новый Массив;

	Для Каждого Регистр Из Метаданные.РегистрыНакопления Цикл

		Если Регистр.ВидРегистра <> Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
			Продолжить;
		КонецЕсли;

		Измерения = Новый Массив;
		Для Каждого Измерение Из Регистр.Измерения Цикл
			Измерения.Добавить(Измерение.Имя);
		КонецЦикла;

		Ресурсы = Новый Массив;
		Для Каждого Ресурс Из Регистр.Ресурсы Цикл
			Ресурсы.Добавить(Ресурс.Имя);
		КонецЦикла;

		Описание = Новый Структура;
		Описание.Вставить("Имя",        Регистр.Имя);
		Описание.Вставить("Синоним",    Регистр.Синоним);
		Описание.Вставить("Измерения",  Измерения);
		Описание.Вставить("Ресурсы",    Ресурсы);
		Результат.Добавить(Описание);

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ВыбратьРегистрЗапасов()

	// Приоритет имён: сначала типовые для УНФ, потом любой подходящий.
	ПриоритетМасок = СтрРазделить("запас,товарынасклад,товарынаскладах,остатк,склад", ",", Ложь);

	Кандидаты = Новый Массив;

	Для Каждого Регистр Из Метаданные.РегистрыНакопления Цикл

		Если Регистр.ВидРегистра <> Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
			Продолжить;
		КонецЕсли;

		ИмяНоменклатуры = ИмяПоМаске(Регистр.Измерения, "номенклат");
		Если ПустаяСтрока(ИмяНоменклатуры) Тогда
			Продолжить;
		КонецЕсли;

		ИмяРесурса = ИмяПоМаске(Регистр.Ресурсы, "колич");
		Если ПустаяСтрока(ИмяРесурса) Тогда
			ИмяРесурса = ИмяПоМаске(Регистр.Ресурсы, "кільк");
		КонецЕсли;
		Если ПустаяСтрока(ИмяРесурса) Тогда
			Продолжить;
		КонецЕсли;

		Кандидаты.Добавить(Регистр);

	КонецЦикла;

	Если Кандидаты.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Выбираем по приоритету масок, иначе первый подходящий.
	Выбранный = Кандидаты[0];
	Для Каждого Маска Из ПриоритетМасок Цикл
		Найден = Ложь;
		Для Каждого Регистр Из Кандидаты Цикл
			Если СтрНайти(НРег(Регистр.Имя), НРег(СокрЛП(Маска))) > 0 Тогда
				Выбранный = Регистр;
				Найден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Найден Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат ОписаниеВыбранногоРегистра(Выбранный);

КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеВыбранногоРегистра(Регистр)

	ИмяНоменклатуры   = ИмяПоМаске(Регистр.Измерения, "номенклат");
	ИмяХарактеристики = ИмяПоМаске(Регистр.Измерения, "характер");
	ИмяСклада         = ИмяПоМаске(Регистр.Измерения, "склад");
	Если ПустаяСтрока(ИмяСклада) Тогда
		ИмяСклада = ИмяПоМаске(Регистр.Измерения, "структурн");
	КонецЕсли;
	Если ПустаяСтрока(ИмяСклада) Тогда
		ИмяСклада = ИмяПоМаске(Регистр.Измерения, "местохран");
	КонецЕсли;
	ИмяЗаказа = ИмяПоМаске(Регистр.Измерения, "заказ");
	Если ПустаяСтрока(ИмяЗаказа) Тогда
		ИмяЗаказа = ИмяПоМаске(Регистр.Измерения, "замовлен");
	КонецЕсли;

	ИмяРесурса = ИмяПоМаске(Регистр.Ресурсы, "колич");
	Если ПустаяСтрока(ИмяРесурса) Тогда
		ИмяРесурса = ИмяПоМаске(Регистр.Ресурсы, "кільк");
	КонецЕсли;

	// Справочник номенклатуры определяем по типу измерения - без догадок об имени.
	ИмяСправочника = "";
	Измерение = Регистр.Измерения.Найти(ИмяНоменклатуры);
	Если Измерение <> Неопределено Тогда
		Для Каждого Тип Из Измерение.Тип.Типы() Цикл
			ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
			Если ОбъектМетаданных <> Неопределено Тогда
				ИмяСправочника = ОбъектМетаданных.Имя;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ИмяРегистра",                 Регистр.Имя);
	Результат.Вставить("СинонимРегистра",             Регистр.Синоним);
	Результат.Вставить("ИзмерениеНоменклатуры",       ИмяНоменклатуры);
	Результат.Вставить("ИзмерениеХарактеристики",     ИмяХарактеристики);
	Результат.Вставить("ИзмерениеСклада",             ИмяСклада);
	Результат.Вставить("ИзмерениеЗаказа",             ИмяЗаказа);
	Результат.Вставить("РесурсКоличества",            ИмяРесурса);
	Результат.Вставить("ИмяСправочникаНоменклатуры",  ИмяСправочника);
	Результат.Вставить("ТекстЗапроса",                "");

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПоляСправочника(ИмяСправочника)

	Результат = Новый Структура;
	Если ПустаяСтрока(ИмяСправочника) Тогда
		Возврат Результат;
	КонецЕсли;

	СправочникМД = Метаданные.Справочники.Найти(ИмяСправочника);
	Если СправочникМД = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Реквизиты = Новый Массив;
	Для Каждого Реквизит Из СправочникМД.Реквизиты Цикл
		Реквизиты.Добавить(Реквизит.Имя);
	КонецЦикла;

	Результат.Вставить("Имя",       СправочникМД.Имя);
	Результат.Вставить("Реквизиты", Реквизиты);
	Возврат Результат;

КонецФункции

// --- пробная выборка данных -----------------------------------------------------

&НаСервереБезКонтекста
Функция ПробнаяВыборка(ОписаниеРегистра, ЛимитСтрок)

	Ном = "Т." + ОписаниеРегистра.ИзмерениеНоменклатуры;
	СправочникМД = Метаданные.Справочники.Найти(ОписаниеРегистра.ИмяСправочникаНоменклатуры);

	ПоляВыборки = Новый Массив;
	ПоляВыборки.Добавить(Ном + " КАК НоменклатураСсылка");
	ПоляВыборки.Добавить(Ном + ".Код КАК Код");
	ПоляВыборки.Добавить(Ном + ".Наименование КАК Наименование");
	Если СправочникМД <> Неопределено И СправочникМД.Иерархический Тогда
		ПоляВыборки.Добавить(Ном + ".Родитель КАК Группа");
	КонецЕсли;

	// Реквизиты добавляем только если они реально есть в конфигурации.
	Если СправочникМД <> Неопределено Тогда
		Для Каждого ИмяРеквизита Из СтрРазделить("Артикул,ЕдиницаИзмерения,Категория,КатегорияНоменклатуры,ВидНоменклатуры,Тип", ",", Ложь) Цикл
			Если СправочникМД.Реквизиты.Найти(СокрЛП(ИмяРеквизита)) <> Неопределено Тогда
				ПоляВыборки.Добавить(Ном + "." + СокрЛП(ИмяРеквизита) + " КАК Рек_" + СокрЛП(ИмяРеквизита));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Не ПустаяСтрока(ОписаниеРегистра.ИзмерениеХарактеристики) Тогда
		ПоляВыборки.Добавить("Т." + ОписаниеРегистра.ИзмерениеХарактеристики + " КАК Характеристика");
	КонецЕсли;
	Если Не ПустаяСтрока(ОписаниеРегистра.ИзмерениеСклада) Тогда
		ПоляВыборки.Добавить("Т." + ОписаниеРегистра.ИзмерениеСклада + " КАК Склад");
	КонецЕсли;
	Если Не ПустаяСтрока(ОписаниеРегистра.ИзмерениеЗаказа) Тогда
		ПоляВыборки.Добавить("Т." + ОписаниеРегистра.ИзмерениеЗаказа + " КАК Заказ");
	КонецЕсли;

	ПоляВыборки.Добавить("Т." + ОписаниеРегистра.РесурсКоличества + "Остаток КАК Количество");

	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(ЛимитСтрок, "ЧГ=0") + Символы.ПС
		+ СтрСоединить(ПоляВыборки, "," + Символы.ПС) + Символы.ПС
		+ "ИЗ РегистрНакопления." + ОписаниеРегистра.ИмяРегистра + ".Остатки КАК Т";

	ОписаниеРегистра.ТекстЗапроса = ТекстЗапроса;

	Запрос = Новый Запрос(ТекстЗапроса);
	Таблица = Запрос.Выполнить().Выгрузить();

	Результат = Новый Массив;

	Для Каждого СтрокаТаблицы Из Таблица Цикл

		ЗаписьРезультата = Новый Структура;

		Для Каждого Колонка Из Таблица.Колонки Цикл

			Значение = СтрокаТаблицы[Колонка.Имя];

			Если Колонка.Имя = "НоменклатураСсылка" Тогда
				// GUID пригодится как вечный ключ товара в Битрикс24.
				Если ЗначениеЗаполнено(Значение) Тогда
					ЗаписьРезультата.Вставить("GUID", Строка(Значение.УникальныйИдентификатор));
				Иначе
					ЗаписьРезультата.Вставить("GUID", "");
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			Если ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
				ЗаписьРезультата.Вставить(Колонка.Имя, Значение);
			ИначеЕсли Значение = Неопределено Или Значение = Null Тогда
				ЗаписьРезультата.Вставить(Колонка.Имя, "");
			Иначе
				ЗаписьРезультата.Вставить(Колонка.Имя, Строка(Значение));
			КонецЕсли;

		КонецЦикла;

		Результат.Добавить(ЗаписьРезультата);

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьJSONВФайл(Данные, ПутьФайла)

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ПутьФайла, "UTF-8", Ложь, ПараметрыЗаписи);
	ЗаписатьJSON(Запись, Данные);
	Запись.Закрыть();

КонецПроцедуры
