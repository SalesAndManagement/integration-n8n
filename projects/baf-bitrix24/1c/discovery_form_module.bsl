////////////////////////////////////////////////////////////////////////////////
// Модуль формы внешней обработки "BAF: разведка метаданных"
//
// НАЗНАЧЕНИЕ: собрать имена объектов метаданных (справочники, регистры) и их
// реквизиты, чтобы построить таблицу соответствия полей BAF -> Битрикс24.
//
// БЕЗОПАСНОСТЬ. Обработка:
//   - читает ТОЛЬКО метаданные (структуру конфигурации), а не данные;
//   - не выполняет ни одного запроса к таблицам базы;
//   - ничего не записывает, не изменяет и не удаляет в базе;
//   - не изменяет конфигурацию;
//   - не устанавливает монопольный режим;
//   - записывает единственный файл - JSON в каталог временных файлов.
// Нагрузка на базу нулевая: метаданные читаются из памяти сеанса.
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Перем ПутьРезультата;

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Пакетный запуск: 1cv8.exe ... /Execute <файл.epf> /C"AUTO"
	// Тогда собираем данные и сразу закрываем сеанс.
	Если ВРег(СокрЛП(ПараметрЗапуска)) = "AUTO" Тогда
		ПутьРезультата = СобратьНаСервере();
		ЗавершитьРаботуСистемы(Ложь, Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Собрать(Команда)

	ПутьРезультата = СобратьНаСервере();
	Сообщить("Готово. Файл: " + ПутьРезультата);

КонецПроцедуры

&НаСервереБезКонтекста
Функция СобратьНаСервере()

	СистемнаяИнформацияСеанса = Новый СистемнаяИнформация;

	Результат = Новый Структура;
	Результат.Вставить("ВерсияПлатформы",      СистемнаяИнформацияСеанса.ВерсияПриложения);
	Результат.Вставить("ИмяКонфигурации",      Метаданные.Имя);
	Результат.Вставить("СинонимКонфигурации",  Метаданные.Синоним);
	Результат.Вставить("ВерсияКонфигурации",   Метаданные.Версия);
	Результат.Вставить("ДатаСбора",            Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"));

	// Подробно - только объекты, которые могут понадобиться для товаров и остатков.
	Результат.Вставить("Справочники",
		ОписаниеСправочников("номенклат,характер,единиц,упаковк,склад,цен,штрихкод,серии,групп,вид"));

	Результат.Вставить("РегистрыНакопления",
		ОписаниеРегистров(Метаданные.РегистрыНакопления, "остат,запас,товар,резерв,склад,свободн"));

	Результат.Вставить("РегистрыСведений",
		ОписаниеРегистров(Метаданные.РегистрыСведений, "цен,штрихкод,номенклат,единиц"));

	// Полные списки только имён - чтобы ничего не пропустить, но и не раздуть файл.
	Результат.Вставить("ВсеСправочники",          СписокИмен(Метаданные.Справочники));
	Результат.Вставить("ВсеРегистрыНакопления",   СписокИмен(Метаданные.РегистрыНакопления));
	Результат.Вставить("ВсеРегистрыСведений",     СписокИмен(Метаданные.РегистрыСведений));
	Результат.Вставить("ВсеПланыВидовХарактеристик", СписокИмен(Метаданные.ПланыВидовХарактеристик));

	ПутьФайла = КаталогВременныхФайлов() + "baf_metadata.json";
	ЗаписатьJSONВФайл(Результат, ПутьФайла);

	Возврат ПутьФайла;

КонецФункции

&НаСервереБезКонтекста
Функция СписокИмен(Коллекция)

	Имена = Новый Массив;
	Для Каждого ОбъектМетаданных Из Коллекция Цикл
		Имена.Добавить(ОбъектМетаданных.Имя);
	КонецЦикла;
	Возврат Имена;

КонецФункции

&НаСервереБезКонтекста
Функция ПодходитПоМаскам(Имя, Маски)

	ИмяПоиска = НРег(Имя);
	Для Каждого Маска Из СтрРазделить(Маски, ",", Ложь) Цикл
		Если СтрНайти(ИмяПоиска, НРег(СокрЛП(Маска))) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеТипа(ОписаниеТипов)

	Части = Новый Массив;
	Для Каждого Тип Из ОписаниеТипов.Типы() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		Если ОбъектМетаданных <> Неопределено Тогда
			Части.Добавить(ОбъектМетаданных.ПолноеИмя());
		Иначе
			Части.Добавить(Строка(Тип));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, " | ");

КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеПолей(Коллекция)

	Поля = Новый Массив;
	Для Каждого Поле Из Коллекция Цикл
		Описание = Новый Структура;
		Описание.Вставить("Имя",     Поле.Имя);
		Описание.Вставить("Синоним", Поле.Синоним);
		Описание.Вставить("Тип",     ПредставлениеТипа(Поле.Тип));
		Поля.Добавить(Описание);
	КонецЦикла;
	Возврат Поля;

КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеСправочников(Маски)

	Результат = Новый Массив;

	Для Каждого Справочник Из Метаданные.Справочники Цикл

		Если Не ПодходитПоМаскам(Справочник.Имя, Маски) Тогда
			Продолжить;
		КонецЕсли;

		ТабличныеЧасти = Новый Массив;
		Для Каждого ТабличнаяЧасть Из Справочник.ТабличныеЧасти Цикл
			ОписаниеТЧ = Новый Структура;
			ОписаниеТЧ.Вставить("Имя",       ТабличнаяЧасть.Имя);
			ОписаниеТЧ.Вставить("Реквизиты", ОписаниеПолей(ТабличнаяЧасть.Реквизиты));
			ТабличныеЧасти.Добавить(ОписаниеТЧ);
		КонецЦикла;

		Описание = Новый Структура;
		Описание.Вставить("Имя",                 Справочник.Имя);
		Описание.Вставить("Синоним",             Справочник.Синоним);
		Описание.Вставить("Иерархический",       Справочник.Иерархический);
		Описание.Вставить("Владельцы",           ПредставлениеВладельцев(Справочник));
		Описание.Вставить("СтандартныеРеквизиты", ОписаниеПолей(Справочник.СтандартныеРеквизиты));
		Описание.Вставить("Реквизиты",           ОписаниеПолей(Справочник.Реквизиты));
		Описание.Вставить("ТабличныеЧасти",      ТабличныеЧасти);

		Результат.Добавить(Описание);

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеВладельцев(Справочник)

	Имена = Новый Массив;
	Для Каждого Владелец Из Справочник.Владельцы Цикл
		Имена.Добавить(Владелец.ПолноеИмя());
	КонецЦикла;
	Возврат СтрСоединить(Имена, " | ");

КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеРегистров(Коллекция, Маски)

	Результат = Новый Массив;

	Для Каждого Регистр Из Коллекция Цикл

		Если Не ПодходитПоМаскам(Регистр.Имя, Маски) Тогда
			Продолжить;
		КонецЕсли;

		Описание = Новый Структура;
		Описание.Вставить("Имя",        Регистр.Имя);
		Описание.Вставить("Синоним",    Регистр.Синоним);
		Описание.Вставить("Измерения",  ОписаниеПолей(Регистр.Измерения));
		Описание.Вставить("Ресурсы",    ОписаниеПолей(Регистр.Ресурсы));
		Описание.Вставить("Реквизиты",  ОписаниеПолей(Регистр.Реквизиты));

		// Вид регистра есть только у регистров накопления, периодичность - у сведений.
		// Проверяем наличие свойства, чтобы модуль работал для обеих коллекций.
		Свойства = Новый Структура("ВидРегистра, ПериодичностьРегистраСведений");
		ЗаполнитьЗначенияСвойств(Свойства, Регистр);
		Если Свойства.ВидРегистра <> Неопределено Тогда
			Описание.Вставить("ВидРегистра", Строка(Свойства.ВидРегистра));
		КонецЕсли;
		Если Свойства.ПериодичностьРегистраСведений <> Неопределено Тогда
			Описание.Вставить("Периодичность", Строка(Свойства.ПериодичностьРегистраСведений));
		КонецЕсли;

		Результат.Добавить(Описание);

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьJSONВФайл(Данные, ПутьФайла)

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ПутьФайла, "UTF-8", Ложь, ПараметрыЗаписи);
	ЗаписатьJSON(Запись, Данные);
	Запись.Закрыть();

КонецПроцедуры
